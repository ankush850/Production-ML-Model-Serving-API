# Copy to .env and fill in. Never commit .env.

# --- Model source: "local" (dev/tests) or "s3" (production) ---
MODEL_SOURCE=local
# Pin a specific timestamped version; empty means read the LATEST pointer
MODEL_VERSION=
LOCAL_MODEL_DIR=models/artifacts

# --- AWS S3 (only needed when MODEL_SOURCE=s3 or for training upload) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-model-bucket
S3_PREFIX=production-ml-serving

# --- Data / artifacts ---
RAW_DATA_PATH=data/raw/online_retail.csv
ARTIFACT_DIR=models/artifacts

# --- API ---
MAX_BATCH_SIZE=100
